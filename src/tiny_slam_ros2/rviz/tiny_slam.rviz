Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.8
      Class: rviz_default_plugins/Map
      Name: SLAM Occupancy Map
      Topic:
        Value: /map
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Virtual LiDAR
      Size (Pixels): 3
      Style: Points
      Topic:
        Value: /scan
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 25; 255; 25
      Line Style: Lines
      Line Width: 0.05
      Name: SLAM Path
      Topic:
        Value: /slam_path
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 255; 80; 25
      Line Style: Lines
      Line Width: 0.03
      Name: Noisy Odometry Path
      Topic:
        Value: /odom_path
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Robot
      Topic:
        Value: /robot_marker
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 70
Window Geometry:
  Height: 850
  Width: 1300
